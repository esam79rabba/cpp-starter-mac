{
  "name": "cpp-starter-mac",
  "displayName": "C++ Starter for Mac",
  "description": "A Visual Studio-like build and debug experience for beginner C++ students on macOS, using Apple clang++ and lldb-dap.",
  "version": "0.0.1",
  "publisher": "cpp-starter",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "os": [
    "darwin"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:cpp"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "llvm-vs-code-extensions.vscode-clangd"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "compile:tests": "tsc -p tsconfig.json",
    "test:unit": "vitest run --configLoader runner",
    "test:integration": "npm run build && npm run compile:tests && node out/test/integration/runTests.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "glob": "^14.0.3",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "contributes": {
    "commands": [
      {
        "command": "cppStarter.checkTools",
        "title": "C++: Check Tools"
      },
      {
        "command": "cppStarter.startDebugging",
        "title": "C++: Start Debugging",
        "icon": "$(debug-alt)"
      },
      {
        "command": "cppStarter.runWithoutDebugging",
        "title": "C++: Start Without Debugging"
      },
      {
        "command": "cppStarter.build",
        "title": "C++: Build",
        "icon": "$(tools)"
      }
    ],
    "debuggers": [
      {
        "type": "cppstarter",
        "label": "C++ (Apple lldb)",
        "languages": [
          "cpp"
        ]
      }
    ],
    "configuration": {
      "title": "C++ Starter",
      "properties": {
        "cppStarter.architecture": {
          "type": "string",
          "enum": [
            "native",
            "x86_64"
          ],
          "default": "native",
          "description": "Build for Intel (x86_64) and run under Rosetta. For testing Intel support on Apple Silicon."
        }
      }
    }
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
}
